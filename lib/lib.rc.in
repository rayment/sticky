#include <windows.h>

#define DLL_FILE_VERSION \
    @VERSION_MAJOR@, @VERSION_MINOR@, @VERSION_PATCH@, 0

#define DLL_FILE_VERSION_STRING "@VERSION_STRING@\0"
#define DLL_PRODUCT_NAME        "@OUTPUT_NAME@\0"
#define DLL_COPYRIGHT           "Copyright (c) @COPYRIGHT_OWNER@ @COPYRIGHT_STRING@\0"

VS_VERSION_INFO VERSIONINFO
    FILEVERSION     DLL_FILE_VERSION
    PRODUCTVERSION  DLL_FILE_VERSION

    FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
    FILEFLAGS       @VERSION_FILEFLAGS@
    FILEOS          VOS_NT_WINDOWS32
    FILETYPE        VFT_DLL
    FILESUBTYPE     VFT2_UNKNOWN

BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904E4"
        BEGIN
            VALUE "CompanyName",      "@COPYRIGHT_OWNER@\0"
            VALUE "FileDescription",  "@OUTPUT_NAME@\0"
            VALUE "FileVersion",      DLL_FILE_VERSION_STRING
            VALUE "InternalName",     "@OUTPUT_NAME@\0"
            VALUE "LegalCopyright",   DLL_COPYRIGHT
            VALUE "OriginalFilename", "@OUTPUT_FILENAME@\0"
            VALUE "ProductName",      DLL_PRODUCT_NAME
            VALUE "ProductVersion",   DLL_FILE_VERSION_STRING
        END
    END

    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1252
    END
END
