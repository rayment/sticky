# Doxygen configuration for the sticky C++ engine (lib/ and src/).
# Only non-default settings are listed. Configured by cmake/Doxygen.cmake.
#
# The reference covers the documented declarations in headers, grouped by module (see groups.dox). Implementation
# files, private members and undocumented symbols are left out to keep it to the API.

PROJECT_NAME           = "sticky"
PROJECT_NUMBER         = "@VERSION_STRING@"
PROJECT_BRIEF          = "C++ engine reference"
OUTPUT_DIRECTORY       = "@CMAKE_BINARY_DIR@/doc/cpp"
QUIET                  = YES

# Input: headers only
INPUT                  = "@CMAKE_SOURCE_DIR@/doc/cpp/mainpage.md" \
                         "@CMAKE_SOURCE_DIR@/doc/cpp/groups.dox" \
                         "@CMAKE_SOURCE_DIR@/lib" \
                         "@CMAKE_SOURCE_DIR@/src"
FILE_PATTERNS          = *.h
RECURSIVE              = YES
STRIP_FROM_PATH        = "@CMAKE_SOURCE_DIR@/lib" \
                         "@CMAKE_SOURCE_DIR@/src"
STRIP_FROM_INC_PATH    = "@CMAKE_SOURCE_DIR@/lib" \
                         "@CMAKE_SOURCE_DIR@/src"
USE_MDFILE_AS_MAINPAGE = "@CMAKE_SOURCE_DIR@/doc/cpp/mainpage.md"

# Extraction: documented public API only
EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = NO
EXTRACT_ANON_NSPACES   = NO
HIDE_UNDOC_MEMBERS     = YES
HIDE_UNDOC_CLASSES     = YES
HIDE_FRIEND_COMPOUNDS  = YES
CASE_SENSE_NAMES       = YES
SORT_MEMBER_DOCS       = NO
GROUP_NESTED_COMPOUNDS = YES
EXCLUDE_SYMBOLS        = *_impl \
                         *_impl::* \
                         ST_STRINGIFY_IMPL

# Preprocessing: neutralise attribute macros and build every module
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
PREDEFINED             = __cplusplus=201703L \
                         ST_MODULE_AUDIO=1 \
                         ST_MODULE_VIDEO=1 \
                         ST_HOT= \
                         ST_COLD= \
                         ST_LIKELY(x)=x \
                         ST_UNLIKELY(x)=x \
                         ST_ALIGNED(n)= \
                         ST_PACKED= \
                         ST_PURE= \
                         ST_CONST= \
                         ST_INLINE= \
                         ST_NOINLINE= \
                         ST_NORETURN= \
                         ST_UNUSED= \
                         "ST_DELETE_COPY_CTORS(x)=" \
                         "ST_DELETE_MOVE_CTORS(x)="

# Warnings: report anything public that lacks documentation
WARN_IF_UNDOCUMENTED   = YES
WARN_NO_PARAMDOC       = NO
WARN_LOGFILE           = "@CMAKE_BINARY_DIR@/doc/cpp/warnings.log"

# No source listings or cross-references
SOURCE_BROWSER         = NO
VERBATIM_HEADERS       = NO
REFERENCED_BY_RELATION = NO
REFERENCES_RELATION    = NO

# HTML output
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
HTML_OUTPUT            = html
HTML_DYNAMIC_SECTIONS  = YES
HTML_COLORSTYLE        = AUTO_LIGHT
GENERATE_TREEVIEW      = YES
FULL_SIDEBAR           = NO
SEARCHENGINE           = YES
SHOW_FILES             = NO
SHOW_INCLUDE_FILES     = YES
FULL_PATH_NAMES        = YES

# Diagrams (requires Graphviz dot): class inheritance only
HAVE_DOT               = @ST_DOXYGEN_HAVE_DOT@
DOT_PATH               = "@ST_DOXYGEN_DOT_PATH@"
CLASS_GRAPH            = YES
COLLABORATION_GRAPH    = NO
INCLUDE_GRAPH          = NO
INCLUDED_BY_GRAPH      = NO
CALL_GRAPH             = NO
CALLER_GRAPH           = NO
DOT_IMAGE_FORMAT       = svg
INTERACTIVE_SVG        = YES
DOT_MULTI_TARGETS      = YES
